# =============================================================
# Pau Brasil Portal — Environment Variables
# Copie este arquivo como .env e preencha com valores reais.
# NUNCA commite o arquivo .env com valores reais.
# =============================================================

# ── Banco de Dados (Neon PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── NextAuth ─────────────────────────────────────────────────
# Gere um novo secret com: openssl rand -base64 32
NEXTAUTH_SECRET=GERE_UM_SECRET_AQUI_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_UPLOAD_PRESET=seu_upload_preset
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=seu_api_secret
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CV_PRESET=seu_cv_preset

# ── Cloudinary (variáveis públicas — expostas ao client) ─────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=seu_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=seu_upload_preset

# ── Resend (E-mail transacional) ─────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@seudominio.com.br

# ── Upstash Redis (Rate limiting distribuído) ─────────────────
# Crie um banco em https://console.upstash.com e copie as credenciais REST
UPSTASH_REDIS_REST_URL=https://SEU_BANCO.upstash.io
UPSTASH_REDIS_REST_TOKEN=SEU_TOKEN_UPSTASH

# ── Node ─────────────────────────────────────────────────────
NODE_ENV=development