# =============================================================
# Pau Brasil Portal — Environment Variables
# Copie este arquivo como .env e preencha com valores reais.
# NUNCA commite o arquivo .env com valores reais.
# =============================================================

# ── Banco de Dados (Neon PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── NextAuth ─────────────────────────────────────────────────
# Gere um novo secret com: openssl rand -base64 32
NEXTAUTH_SECRET=GERE_UM_SECRET_AQUI_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ── Armazenamento de arquivos (Vercel Blob privado) ──────────
# Currículos, laudos PCD, backups e imagens do portal. Na Vercel é criado
# sozinho ao ligar um Blob privado ao projeto (Storage → Blob).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ── Resend (E-mail transacional) ─────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@seudominio.com.br

# ── Upstash Redis (Rate limiting distribuído) ─────────────────
# Crie um banco em https://console.upstash.com e copie as credenciais REST
UPSTASH_REDIS_REST_URL=https://SEU_BANCO.upstash.io
UPSTASH_REDIS_REST_TOKEN=SEU_TOKEN_UPSTASH

# ── Node ─────────────────────────────────────────────────────
NODE_ENV=development